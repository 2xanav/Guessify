# Client ID from https://developer.spotify.com/dashboard (no client secret needed)
VITE_SPOTIFY_CLIENT_ID=

# Optional. Defaults to the page's own origin, e.g. http://127.0.0.1:5173/
# Must exactly match a Redirect URI registered in the Spotify dashboard.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
